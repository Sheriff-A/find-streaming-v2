# Copy this file to .env and fill in real values. .env is gitignored.

DB_NAME=find_streaming
DB_USER=find_streaming
DB_PASSWORD=change-me

JWT_SECRET=change-me-to-a-long-random-base64-string
JWT_EXPIRATION_MINUTES=optional-jwt-expiration-in-minutes # Default: 15
JWT_REFRESH_EXPIRATION_DAYS=optional-jwt-refresh-expiration-in-days # Default: 30